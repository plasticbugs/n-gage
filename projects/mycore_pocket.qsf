# ==============================================================================
# Quartus Prime Settings File
# Generated by OpenGateware - Gateman CLI v0.1.0
# ==============================================================================
# WARNING: DO NOT ADD FILES TO THE PROJECT VIA THE QUARTUS IDE!
# Add them manually to mycore_pocket.qip or Quartus will overwrite this file.
# ==============================================================================

# ==============================================================================
# Project-Wide Assignments
# ==============================================================================
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 17.0.0
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.1 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name TOP_LEVEL_ENTITY apf_top

# ==============================================================================
# Compiler Assignments
# ==============================================================================
set_global_assignment -name NUM_PARALLEL_PROCESSORS 1
# Area-first: the enable-stepped cores have generous multicycle budgets (see
# the .sdc), so trading peak Fmax for logic density is the right side of the
# curve -- the SPEED/HIGH-PERFORMANCE setting overflowed the device by 59 ALMs.
set_global_assignment -name OPTIMIZATION_MODE "AGGRESSIVE AREA"
set_global_assignment -name SAVE_DISK_SPACE OFF
set_global_assignment -name SMART_RECOMPILE OFF

# ==============================================================================
# Analysis & Synthesis Assignments
# ==============================================================================
set_global_assignment -name ADV_NETLIST_OPT_SYNTH_WYSIWYG_REMAP ON
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE ON
set_global_assignment -name MUX_RESTRUCTURE ON
set_global_assignment -name OPTIMIZATION_TECHNIQUE AREA
# The binding constraint is LAB packing, not raw ALM count (ALMs fit at
# 18,454/18,480 while the fitter still wanted 1,860 of 1,848 LABs), so pack
# registers for density explicitly.
set_global_assignment -name AUTO_PACKED_REGISTERS_STRATIXII "MINIMIZE AREA WITH CHAINS"
set_global_assignment -name PRE_MAPPING_RESYNTHESIS ON
set_global_assignment -name REMOVE_REDUNDANT_LOGIC_CELLS ON
set_global_assignment -name SAFE_STATE_MACHINE OFF
set_global_assignment -name SYNTH_GATED_CLOCK_CONVERSION ON
set_global_assignment -name SYNTH_PROTECT_SDC_CONSTRAINT ON

# ==============================================================================
# Fitter Assignments
# ==============================================================================
set_global_assignment -name CRC_ERROR_OPEN_DRAIN ON
set_global_assignment -name ECO_OPTIMIZE_TIMING ON
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
# AUTO FIT stops as soon as it believes constraints are met and leaves margin
# on the table; at 99% utilisation, with setup and hold trading against each
# other, we need every picosecond the placer can find.
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name PERIPHERY_TO_CORE_PLACEMENT_AND_ROUTING_OPTIMIZATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_ASYNCHRONOUS_SIGNAL_PIPELINING ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION OFF
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name ROUTER_CLOCKING_TOPOLOGY_ANALYSIS ON
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION ON

# ==============================================================================
# Pin & Location Assignments
# ==============================================================================
set_global_assignment -name SOURCE_TCL_SCRIPT_FILE ../platform/pocket/bsp/pocket/sys_assign.tcl

# ==============================================================================
# Platform Modules, Constrains and Chain Description File
# ==============================================================================
set_global_assignment -name QIP_FILE mycore_pocket.qip
set_global_assignment -name CDF_FILE mycore_pocket.cdf
# NOTE: mycore_pocket.sdc is deliberately NOT listed here. Quartus reads SDC
# files in the order they appear, and the Pocket BSP's sys_constr.sdc is what
# creates clk_74a, clk_74b and the PLL output clocks. Listed here, this core's
# constraints are read first and every get_clocks in them matches nothing --
# which is exactly what happened: the whole set_clock_groups was silently
# ignored. It is listed after the BSP's instead, further down this file.

# ==============================================================================
# Core RTL Assignments
# ==============================================================================
set_global_assignment -name QIP_FILE ../rtl/index.qip

# ==============================================================================
# Incremental Compilation Assignments
# ==============================================================================
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
# ==============================================================================
# SDRAM. 272 KB of graphics and speech data do not fit in block RAM, so the
# external memory is in use and its pins need real I/O constraints.
# ==============================================================================
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to dram_*
set_instance_assignment -name FAST_INPUT_REGISTER  ON -to dram_dq[*]
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to dram_dq[*]
# No programmable input delay on the data pins. Left free, the fitter used the
# I/O delay chain to buy read-capture hold on one fit and not the next: 2.84 ns
# pin-to-register became 5.6 ns between two compiles of the same RTL, and the
# 3.3 ns capture window slid from +2.57/+0.77 to -0.19/+3.6. The SDRAM phase is
# derived for a fixed pin-to-register delay; pinning it here is what makes that
# derivation hold from one build to the next, CI included.
# (Cyclone V names these by delay-chain element: D1 is pad to input register,
# D3 input register to core. The fit report's Delay Chain Summary showed the
# fitter setting D1 to anything from 1 to 10 units per data pin.)
set_instance_assignment -name D1_DELAY 0 -to dram_dq[*]
set_instance_assignment -name D3_DELAY 0 -to dram_dq[*]

set_global_assignment -name PRE_FLOW_SCRIPT_FILE "quartus_sh:../platform/pocket/scripts/pre_flow.tcl"
set_global_assignment -name POST_FLOW_SCRIPT_FILE "quartus_sh:../platform/pocket/scripts/post_flow.tcl"
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name TIMING_ANALYZER_MULTICORNER_ANALYSIS ON
set_global_assignment -name TIMING_ANALYZER_REPORT_WORST_CASE_TIMING_PATHS ON
set_global_assignment -name OUTPUT_IO_TIMING_NEAR_END_VMEAS "HALF VCCIO" -fall
set_global_assignment -name OUTPUT_IO_TIMING_NEAR_END_VMEAS "HALF VCCIO" -rise
set_global_assignment -name OUTPUT_IO_TIMING_FAR_END_VMEAS "HALF SIGNAL SWING" -fall
set_global_assignment -name OUTPUT_IO_TIMING_FAR_END_VMEAS "HALF SIGNAL SWING" -rise
set_parameter -name NSX_DEVICE_ID pocket
set_parameter -name NSX_DEVICE_MAKER Analogue
set_parameter -name NSX_DEVICE_NAME "Analogue Pocket"
set_parameter -name NSX_DEVICE_PLATFORM Intel
set_parameter -name NSX_DEVICE_USE_HPS OFF
